# Copy to .env.local for local development.
# For production, set these in Vercel: Project -> Settings -> Environment Variables.
# Never commit .env.local — it is gitignored.

# ---- Site ----------------------------------------------------------------
# Canonical URL. Drives canonical tags, OG image resolution, sitemap, RSS.
# No trailing slash. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Contact form (Resend) ----------------------------------------------
# Get a key at https://resend.com/api-keys
# Without it the form returns 503 and points visitors at your email instead.
RESEND_API_KEY=

# Optional sender address. Requires a domain verified in Resend.
# Defaults to Resend's shared onboarding@resend.dev, which works but is more
# likely to land in spam.
CONTACT_FROM_EMAIL=

# ---- Admin (/admin) ------------------------------------------------------
# Password for the admin login. Use something long and random.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- Admin -> GitHub -----------------------------------------------------
# The admin commits blog MDX to this repo via the GitHub Contents API.
# Create a fine-grained personal access token at
#   https://github.com/settings/personal-access-tokens
# scoped to ONLY this repository, with Repository permissions:
#   Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=DelMellomida/portfolio
GITHUB_BRANCH=main
